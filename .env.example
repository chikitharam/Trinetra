# TRINETRA Environment Credentials
PORT=8000
HOST=0.0.0.0

# Firebase Configuration
# Optional: Path to Firebase Service Account JSON file (e.g., config/serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Alternatively, set individual Firebase Admin variables:
FIREBASE_PROJECT_ID=trinetra-cyber-intelligence
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: Google Gemini AI Key for live threat extraction & chat assistance
GEMINI_API_KEY=
